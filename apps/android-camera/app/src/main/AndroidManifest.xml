<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Monitor mode remains usable on devices without local camera hardware. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Beacon View"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeaconSecureView">
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <!-- Push enrollment is opt-in. The notification milestone enables FCM only after the
             signed-in user accepts the in-app explanation and Android permission prompt. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <!-- Picture-in-picture (ADR 0088): the live view floats when you leave
             the app. The activity handles size and orientation changes itself,
             so floating (or rotating) never restarts it and drops the stream;
             the UI is Compose and the camera runs in its own service. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Static launcher shortcuts (ADR 0095); favorite cameras are added in code. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Canonical verified HTTPS links open Beacon when installed and fall back to the web page otherwise. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="beacon.builtbysai.com"
                    android:pathPrefix="/pair"
                    android:scheme="https" />
                <data
                    android:host="beacon.builtbysai.com"
                    android:pathPrefix="/auth/mobile"
                    android:scheme="https" />
            </intent-filter>
            <!-- OAuth returns through a one-time code. This explicit app scheme is the
                 reliable fallback for locally/debug-signed builds that cannot satisfy
                 production Android App Link certificate verification. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth"
                    android:pathPrefix="/mobile"
                    android:scheme="beaconsecureview" />
            </intent-filter>
        </activity>
        <!-- The signed-in app: the web app in a locked-down WebView (ADR 0121). -->
        <activity
            android:name=".WebShellActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- Google sign-in returns here from the system browser with a one-time code that only this app can redeem
                 (it is bound to a PKCE verifier the app never shares). Nothing else is exported. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth"
                    android:pathPrefix="/desktop"
                    android:scheme="beaconsecureview" />
            </intent-filter>
        </activity>
        <service
            android:name=".CameraForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone"
            android:stopWithTask="false" />
        <!-- After a restart or an app update the camera is off; this only posts a "tap to turn it on" reminder (V50). -->
        <receiver
            android:name=".BootResumeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".BeaconFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
