{
  "name": "@beacon/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@beacon/shared-types": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/websocket": "11.3.0",
    "@node-rs/argon2": "2.0.2",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "google-auth-library": "10.5.0",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "ws": "8.21.3"
  }
}
