# Local development only. Do not use these values in production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://beacon_local:local-development-only@127.0.0.1:5432/beacon_secureview
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:3000
SIGNALING_PUBLIC_URL=ws://127.0.0.1:3000/api/signaling
ALLOW_INSECURE_LOCAL_DEV=true
SESSION_COOKIE_NAME=beacon_session
VIEWER_STUN_URL=stun:127.0.0.1:3478
VIEWER_TURN_URL=turn:127.0.0.1:3478?transport=udp
VIEWER_TURN_TCP_URL=turn:127.0.0.1:3478?transport=tcp
DEVICE_STUN_URL=stun:10.0.2.2:3478
DEVICE_TURN_URL=turn:10.0.2.2:3478?transport=udp
DEVICE_TURN_TCP_URL=turn:10.0.2.2:3478?transport=tcp
TURN_SHARED_SECRET=local-development-turn-shared-secret
TURN_CREDENTIAL_TTL_SECONDS=600
ICE_TRANSPORT_POLICY=all

# Optional notification transport. Leave blank until test keys and provider credentials exist.
# Generate each application key as 32 random bytes encoded with base64url; never reuse them.
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_FINGERPRINT_KEY=
NOTIFICATION_OFFLINE_GRACE_SECONDS=120
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Physical-device LAN mode is normally set by scripts/Start-BeaconLanDev.ps1:
# HOST=0.0.0.0
# WEB_ORIGIN=https://192.0.2.10:8443
# PUBLIC_BACKEND_ORIGIN=https://192.0.2.10:8443
# SIGNALING_PUBLIC_URL=wss://192.0.2.10:8443/api/signaling
# ALLOW_INSECURE_LOCAL_DEV=false
# Set every VIEWER_/DEVICE_ STUN and TURN host to the same reachable LAN address.
