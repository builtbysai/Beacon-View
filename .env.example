# Optional Docker Compose values for localhost development.
BEACON_HTTPS_HOST=localhost
BEACON_HTTPS_BIND=127.0.0.1
BEACON_TURN_BIND=127.0.0.1
BEACON_TURN_ADDRESS=127.0.0.1
BEACON_TURN_MIN_PORT=49160
BEACON_TURN_MAX_PORT=49200
BEACON_WEB_UPSTREAM=host.docker.internal:5173

