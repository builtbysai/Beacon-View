# Copy to /etc/beacon/production.env on the VM; do not place this file in Git.
BEACON_DOMAIN=beacon.builtbysai.com
TURN_EXTERNAL_IP=replace-with-your-reserved-or-current-public-ipv4
POSTGRES_DB=beacon_secureview
POSTGRES_USER=beacon
POSTGRES_PASSWORD=generate-a-long-random-value
TURN_SHARED_SECRET=generate-a-separate-random-value-at-least-32-characters
# Optional Google sign-in. Set all three values together; keep the secret only on the VM.
# The redirect URI must exactly match the Google Cloud Console client configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://beacon.builtbysai.com/api/auth/google/callback
# Optional public contact form. Set all three values together only after the sender is
# verified; the API key and recipient stay in /etc/beacon/production.env, never Git.
CONTACT_EMAIL_TO=owner@example.com
RESEND_API_KEY=
RESEND_FROM=Beacon Security <security@auth.builtbysai.com>
# Notification transport (leave unset until the authenticated subscription/outbox
# milestone is deployed). The credential path is inside the backend container; mount
# the root-owned VM file read-only and never place its JSON contents in this env file.
FIREBASE_PROJECT_ID=beacon-view-158ad
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-fcm-sender.json
# Web Push uses standard VAPID. Only the public key may be exposed to clients.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=https://beacon.builtbysai.com
# Encrypted off-VM backups. Copy these to /etc/beacon/backup.env instead of this
# application file; they are deliberately separate from runtime configuration.
# OCI_OBJECT_STORAGE_ACCESS_KEY_ID=
# OCI_OBJECT_STORAGE_REGION=us-ashburn-1
# OCI_OBJECT_STORAGE_REPOSITORY=s3:https://<namespace>.compat.objectstorage.<region>.oraclecloud.com/<bucket>
# OCI_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# BACKUP_RESTIC_PASSWORD=generate-a-separate-long-random-value
