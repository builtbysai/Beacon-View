(beacon_api) {
	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /health {
		reverse_proxy backend:3000
	}

	handle /ready {
		reverse_proxy backend:3000
	}
}

{$BEACON_DOMAIN} {
	encode zstd gzip
	import beacon_api

	# Desktop app downloads (ADR 0083), published to /opt/beacon/downloads on
	# the host and mounted read-only. Missing files are a real 404, never the
	# app shell, and the manifest is always revalidated.
	handle /downloads/* {
		root * /srv
		@manifest path /downloads/manifest.json
		header @manifest Cache-Control "no-cache"
		@installers not path /downloads/manifest.json
		header @installers Cache-Control "public, max-age=3600"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
