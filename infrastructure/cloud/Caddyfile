(beacon_api) {
	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /health {
		reverse_proxy backend:3000
	}

	handle /ready {
		reverse_proxy backend:3000
	}
}

# Optional independently deployed Beacon products. An empty glob is valid.
import /etc/caddy/products/*.caddy

{$BEACON_DOMAIN} {
	encode zstd gzip

	# Browser hardening (F2). The policy is report-only until a full pass
	# through sign-in, live view, Camera Mode, Cast and recordings shows no
	# violations in the console; then rename the header to enforce it.
	# Camera and microphone stay allowed for this origin only (Camera Mode,
	# Talk). HSTS does not cover subdomains: other Beacon products share this
	# VM on their own hostnames (ADR 0106).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://lh3.googleusercontent.com; media-src 'self' blob:; connect-src 'self' wss://{$BEACON_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# The Cast receiver shows a guest link in a frame on this same origin, which
	# X-Frame-Options DENY would block; same-origin framing is allowed for guest
	# pages only. (When the policy is enforced, frame-ancestors needs the same
	# exception for /g/*.)
	@guestpage path /g/*
	header @guestpage >X-Frame-Options "SAMEORIGIN"

	import beacon_api

	# Desktop app downloads (ADR 0083), published to /opt/beacon/downloads on
	# the host and mounted read-only. Missing files are a real 404, never the
	# app shell, and the manifest is always revalidated.
	handle /downloads/* {
		root * /srv
		# The manifest and the update feeds (latest*.yml, ADR 0085) always
		# revalidate so a release is seen at once.
		@manifest path /downloads/manifest.json /downloads/*.yml
		header @manifest Cache-Control "no-cache"
		@installers not path /downloads/manifest.json /downloads/*.yml
		header @installers Cache-Control "public, max-age=3600"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
