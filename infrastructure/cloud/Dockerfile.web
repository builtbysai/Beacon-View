FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web-viewer/package.json apps/web-viewer/package.json
COPY packages/config packages/config
COPY apps/backend/package.json apps/backend/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
RUN corepack enable && pnpm install --frozen-lockfile

COPY apps/web-viewer apps/web-viewer
RUN pnpm --filter @beacon/web-viewer build

FROM caddy:2.10.2-alpine

COPY --from=build /app/apps/web-viewer/dist /srv
COPY infrastructure/cloud/Caddyfile /etc/caddy/Caddyfile
