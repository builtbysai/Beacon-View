FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json apps/backend/package.json
COPY packages/config packages/config
COPY apps/web-viewer/package.json apps/web-viewer/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
RUN corepack enable && pnpm install --frozen-lockfile

COPY apps/backend apps/backend
COPY packages/shared-types packages/shared-types
RUN pnpm --filter @beacon/backend build

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
# The backend and the migration jobs that share this image need no privileges (F4).
# The built-in unprivileged `node` user (uid 1000) runs them; any mounted secret file,
# such as the Firebase credential, must be readable by that uid.
COPY --from=build /app /app
USER node
CMD ["node", "apps/backend/dist/index.js"]
